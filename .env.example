# Copiez ce fichier vers .env puis remplissez-le. Le fichier .env n'est jamais commité.

# Clé SECRÈTE Stripe (Dashboard > Développeurs > Clés API). Jamais la clé publique pk_...
STRIPE_SECRET_KEY=sk_live_xxx

# Frais de port fixes en euros (laisser vide pour ne pas facturer de livraison)
SHIPPING_EUR=4.90

# URL de redirection après paiement (laisser vide pour la page de confirmation Stripe)
SUCCESS_URL=
